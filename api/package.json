{
  "name": "tdc-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": { "node": "22.x" },
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "build": "prisma generate && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "start": "bun src/index.ts",
    "lint": "eslint .",
    "reset": "prisma migrate reset",
    "type": "tsc",
    "generate": "prisma generate",
    "pull": "prisma db pull",
    "postinstall": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed": "bun src/seed/run.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "prisma": "7.10.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "10.10.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
